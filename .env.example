# Copier en .env. Mêmes noms de variables que le worker (mavg/.env.local).
#
# ATTENTION : avec la vraie chaîne de connexion, un run lancé arrive dans la file
# que le worker consomme. Pour essayer, pointer sur une base locale (voir docker-compose.yml).

# Chaîne de connexion. Pour la base managée Scaleway, garder `tlsCAFile=certs/mgdb-mavg.pem`
# (chemin relatif : lancer le service depuis la racine du repo).
MONGO_CONNECTION_STRING=
MONGO_PLATFORM_DATABASE_NAME=

# La file que le worker consomme (`COLLECTION` dans mavg/main.py), et les configs de base.
MONGO_COLLECTION=tasks
MONGO_CHANNELS_COLLECTION=channels

# Stockage objet (avatars, voix, vidéos publiées). Une clé en lecture suffit pour la galerie
# et les aperçus ; l'import d'avatar a besoin du droit d'écriture sur le bucket.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=

# Accès à l'interface (HTTP Basic). Sans identifiants, le service refuse de démarrer,
# sauf AUTH_DISABLED=1 (poste de dev uniquement).
WEB_USER=
WEB_PASSWORD=
# AUTH_DISABLED=1

# L'onglet Assistant : le LLM de la machine GPU (service `llm` de mavg, mêmes variables que
# le worker). Le Studio doit pouvoir le joindre : http://llm:30000 depuis le réseau Docker
# mavg_default (docker run --network mavg_default), http://localhost:30000 hors Docker.
# Sans LLM_BASE_URL, l'assistant répond 503 ; le reste du Studio fonctionne.
LLM_BASE_URL=
LLM_TOKEN=
# ASSISTANT_MODEL=DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NM-DAU
